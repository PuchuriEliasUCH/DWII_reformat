@model AltaMesa.web.Models.ViewModels.PedidoDetalleVM

@{
    ViewBag.Title = "Pedido Mesa " + Model.Pedido.NumeroMesa;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Pedido - Mesa @Model.Pedido.NumeroMesa</h2>
        <span class="badge @(Model.Pedido.Estado == "Abierto" ? "bg-primary" : Model.Pedido.Estado == "En preparacion" ? "bg-warning text-dark" : "bg-info") fs-6">@Model.Pedido.Estado</span>
    </div>
    <div>
        @if (Model.Pedido.Estado != "Cerrado" && Model.Pedido.Estado != "Anulado")
        {
            using (Html.BeginForm("Cerrar", "Pedido", new { id = Model.Pedido.IdPedido }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success" onclick="return confirm('¿Cerrar este pedido?')">Cerrar Pedido</button>
            }
        }
        <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Productos</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unit.</th>
                            <th>Subtotal</th>
                            <th>Estado</th>
                            <th>Adicional</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Pedido.Detalles != null && Model.Pedido.Detalles.Any())
                        {
                            foreach (var d in Model.Pedido.Detalles)
                            {
                                <tr>
                                    <td>@d.NombreProducto</td>
                                    <td>@d.Cantidad</td>
                                    <td>$@d.PrecioUnitario.ToString("N2")</td>
                                    <td>$@d.Subtotal.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(d.EstadoDetalle == "Entregado" ? "bg-success" : d.EstadoDetalle == "Anulado" ? "bg-danger" : "bg-warning text-dark")">
                                            @d.EstadoDetalle
                                        </span>
                                    </td>
                                    <td>
                                        @if (d.EsAdicional)
                                        {
                                            <span class="badge bg-info">Sí</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No hay productos en este pedido</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Resumen</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>Mesero:</strong> @Model.Pedido.NombreMesero</p>
                <p class="mb-1"><strong>Fecha:</strong> @Model.Pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
                <hr />
                <p class="mb-1"><strong>Subtotal:</strong> $@Model.Pedido.Subtotal.ToString("N2")</p>
                <p class="mb-1"><strong>Descuento:</strong> $@Model.Pedido.Descuento.ToString("N2")</p>
                <p class="mb-0 fs-5 fw-bold"><strong>Total:</strong> $@Model.Pedido.Total.ToString("N2")</p>
            </div>
        </div>

        @if (Model.Pedido.Estado != "Cerrado" && Model.Pedido.Estado != "Anulado")
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Agregar Producto</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("AgregarDetalle", "Pedido", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("Pedido.IdPedido", Model.Pedido.IdPedido)

                        <div class="mb-3">
                            <label class="form-label">Producto</label>
                            @Html.DropDownList("Producto", Model.Productos, "Seleccione producto", new { @class = "form-select" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad</label>
                            @Html.TextBox("Cantidad", 1, new { @class = "form-control", type = "number", min = 1 })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observación</label>
                            @Html.TextArea("Obs", null, new { @class = "form-control", rows = 2 })
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Agregar</button>
                    }
                </div>
            </div>
        }
    </div>
</div>
