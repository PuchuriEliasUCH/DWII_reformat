@model AltaMesa.web.Models.ViewModels.PedidoCrearVM

@{
    ViewBag.Title = "Nuevo Pedido";
}

<h2 class="mb-4">Nuevo Pedido</h2>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Crear", "Pedido", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Mesa, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Mesa, Model.Mesas, "Seleccione una mesa disponible", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Mesa, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Obs, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Obs, new { @class = "form-control", rows = 2 })
                @Html.ValidationMessageFor(m => m.Obs, "", new { @class = "text-danger" })
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Crear Pedido</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            </div>
        }
    </div>
</div>
