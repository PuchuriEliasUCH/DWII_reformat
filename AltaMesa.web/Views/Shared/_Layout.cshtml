@using System.Web
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AltaMesa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        var usuarioId = Session["UsuarioId"];
        var usuarioNombre = Session["UsuarioNombre"]?.ToString();
        var usuarioRol = Session["UsuarioRol"]?.ToString();
    }

    @if (usuarioId != null)
    {
        <div class="layout-wrapper">
            @* Sidebar — bottom nav on mobile, side panel on desktop *@
            <div class="sidebar">
                <div class="sidebar-brand-section">
                    <h5>AltaMesa</h5>
                    <small>@usuarioRol</small>
                </div>
                <nav>
                    <ul class="nav">
                        @if (string.Equals(usuarioRol, "admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Dashboard")" class="nav-link@(currentController == "Dashboard" ? " active" : "")" title="Dashboard">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                    <span class="nav-text">Dashboard</span>
                                </a>
                            </li>
                        }
                        @if (string.Equals(usuarioRol, "admin", StringComparison.OrdinalIgnoreCase) || string.Equals(usuarioRol, "mesero", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Pedido")" class="nav-link@(currentController == "Pedido" ? " active" : "")" title="Pedidos">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                                    <span class="nav-text">Pedidos</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Mesa")" class="nav-link@(currentController == "Mesa" ? " active" : "")" title="Mesas">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/></svg>
                                    <span class="nav-text">Mesas</span>
                                </a>
                            </li>
                        }
                        @if (string.Equals(usuarioRol, "admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Usuario")" class="nav-link@(currentController == "Usuario" ? " active" : "")" title="Usuarios">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    <span class="nav-text">Usuarios</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Categoria")" class="nav-link@(currentController == "Categoria" ? " active" : "")" title="Categorías">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                    <span class="nav-text">Categorías</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Producto")" class="nav-link@(currentController == "Producto" ? " active" : "")" title="Productos">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                                    <span class="nav-text">Productos</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Historial", "Pedido")" class="nav-link@(currentController == "Pedido" && currentAction == "Historial" ? " active" : "")" title="Historial">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    <span class="nav-text">Historial</span>
                                </a>
                            </li>
                        }
                        @if (string.Equals(usuarioRol, "chef", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Cocina")" class="nav-link@(currentController == "Cocina" ? " active" : "")" title="Cocina">
                                    <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
                                    <span class="nav-text">Cocina</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
                <div class="sidebar-logout">
                    @using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { @class = "mb-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost w-100">Cerrar Sesión</button>
                    }
                </div>
            </div>

            @* Main content area *@
            <div class="main-content">
                <nav class="navbar navbar-expand">
                    <div class="container-fluid">
                        <a class="navbar-brand d-md-none" href="#">AltaMesa</a>
                        <div></div>
                        <div class="d-flex align-items-center gap-2 gap-md-3">
                            <span class="body-sm text-on-surface-variant">@usuarioRol</span>
                            <button class="theme-toggle" id="themeToggleBtn" type="button" title="Cambiar tema">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                                <svg class="d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                            </button>
                            @using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { @class = "mb-0 d-none d-md-inline-flex" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-ghost">Cerrar Sesión</button>
                            }
                        </div>
                    </div>
                </nav>
                <div class="main-content-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    @* Toast container *@
    <div aria-live="polite" aria-atomic="true" class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index:9999">
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/signalr")
    <script src="/signalr/hubs"></script>
    <script>
        function mostrarToast(mensaje, tipo) {
            tipo = tipo || 'success';
            var bg = tipo === 'success' ? 'var(--status-success)' : tipo === 'error' ? 'var(--error)' : tipo === 'warning' ? 'var(--warning)' : 'var(--status-new-order)';
            var icono = tipo === 'success' ? '&#10003;' : tipo === 'error' ? '&#10007;' : tipo === 'warning' ? '&#9888;' : '&#8505;';
            var html = '<div class="toast" role="alert" aria-live="assertive" aria-atomic="true">' +
                '<div class="toast-header" style="background:' + bg + ';color:#fff">' +
                '<strong class="me-auto">' + icono + ' AltaMesa</strong>' +
                '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>' +
                '</div>' +
                '<div class="toast-body">' + mensaje + '</div>' +
                '</div>';
            var container = document.getElementById('toastContainer');
            container.insertAdjacentHTML('beforeend', html);
            var el = container.lastElementChild;
            var toast = new bootstrap.Toast(el, { delay: 4000 });
            toast.show();
            el.addEventListener('hidden.bs.toast', function () { el.remove(); });
        }

        @if (TempData["Success"] != null)
        {
            <text>mostrarToast('@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Success"].ToString()))', 'success');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>mostrarToast('@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Error"].ToString()))', 'error');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>mostrarToast('@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Warning"].ToString()))', 'warning');</text>
        }
        @if (TempData["Info"] != null)
        {
            <text>mostrarToast('@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Info"].ToString()))', 'info');</text>
        }
    </script>
    <script>
        (function () {
            var html = document.documentElement;
            var theme = localStorage.getItem('altamesa-theme') || 'light';
            html.setAttribute('data-theme', theme);
            updateToggleButtons(theme);

            function updateToggleButtons(t) {
                [].forEach.call(document.querySelectorAll('.theme-toggle'), function (btn) {
                    var sun = btn.querySelector('svg:first-child');
                    var moon = btn.querySelector('svg:last-child');
                    if (sun && moon) {
                        sun.classList.toggle('d-none', t === 'dark');
                        moon.classList.toggle('d-none', t === 'light');
                    }
                });
            }

            [].forEach.call(document.querySelectorAll('.theme-toggle'), function (btn) {
                btn.addEventListener('click', function () {
                    var current = html.getAttribute('data-theme') || 'light';
                    var next = current === 'dark' ? 'light' : 'dark';
                    html.setAttribute('data-theme', next);
                    localStorage.setItem('altamesa-theme', next);
                    updateToggleButtons(next);
                });
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
