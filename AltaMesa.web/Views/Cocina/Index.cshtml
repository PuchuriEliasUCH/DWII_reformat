@model AltaMesa.web.Models.ViewModels.CocinaListaVM

@{
    ViewBag.Title = "Cocina";
}

<div class="page-header">
    <h2>Cocina</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header section-header-preparacion">
                <h5 class="headline-sm mb-0">En Preparación</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width:35%">Producto</th>
                                <th style="width:10%">Cant.</th>
                                <th style="width:15%">Mesa</th>
                                <th style="width:20%">Obs.</th>
                                <th style="width:15%">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ColaCocina.Any())
                            {
                                foreach (var item in Model.ColaCocina)
                                {
                                    <tr>
                                        <td class="fw-medium">@item.NombreProducto</td>
                                        <td>@item.Cantidad</td>
                                        <td>Mesa @item.NumeroMesa</td>
                                        <td class="body-sm text-on-surface-variant">@item.Observacion</td>
                                        <td>
                                            @using (Html.BeginForm("CambiarEstado", "Cocina", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="detalleId" value="@item.IdDetallePedido" />
                                                <input type="hidden" name="estado" value="Listo para servir" />
                                                <button type="submit" class="btn btn-sm btn-secondary">Listo</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-on-surface-variant py-4">No hay productos en preparación</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header section-header-listo">
                <h5 class="headline-sm mb-0">Listos para Servir</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width:50%">Producto</th>
                                <th style="width:20%">Cant.</th>
                                <th style="width:30%">Mesa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ProductosListos.Any())
                            {
                                foreach (var item in Model.ProductosListos)
                                {
                                    <tr>
                                        <td class="fw-medium">@item.NombreProducto</td>
                                        <td>@item.Cantidad</td>
                                        <td>Mesa @item.NumeroMesa</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-on-surface-variant py-4">No hay productos listos</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var cocinaHub = $.connection.cocinaHub;
            cocinaHub.client.nuevoDetalleCocina = function () { location.reload(); };
            cocinaHub.client.actualizarDetalleCocina = function () { location.reload(); };
            $.connection.hub.start().done(function () {
                cocinaHub.server.joinGroup();
            });
        });
    </script>
}
