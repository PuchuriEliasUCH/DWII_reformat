@{
    ViewBag.Title = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-lg mb-3" style="color: var(--primary);">AltaMesa</h1>
    <p class="body-lg text-on-surface-variant mb-4">Sistema de Gestión de Pedidos para restaurantes</p>
    <div class="row g-4 justify-content-center mt-4">
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <h3 class="headline-md mb-2">Pedidos</h3>
                <p class="body-md text-on-surface-variant mb-3">Gestione los pedidos activos del restaurante en tiempo real.</p>
                <a href="@Url.Action("Index", "Pedido")" class="btn btn-primary mt-auto">Ver Pedidos</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <h3 class="headline-md mb-2">Mesas</h3>
                <p class="body-md text-on-surface-variant mb-3">Administre el estado y disposición de las mesas.</p>
                <a href="@Url.Action("Index", "Mesa")" class="btn btn-secondary mt-auto">Ver Mesas</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4">
                <h3 class="headline-md mb-2">Cocina</h3>
                <p class="body-md text-on-surface-variant mb-3">Vea los pedidos en preparación y marque como listos.</p>
                <a href="@Url.Action("Index", "Cocina")" class="btn btn-secondary mt-auto">Ver Cocina</a>
            </div>
        </div>
    </div>
</div>
