@model AltaMesa.web.Models.ViewModels.MesaEditarVM

@{
    ViewBag.Title = "Editar Mesa";
}

<div class="page-header">
    <h2>Editar Mesa</h2>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Editar", "Mesa", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdMesa)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Número</label>
                    <input type="text" class="form-control" value="Mesa @Model.Numero" disabled />
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.Capacidad, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Capacidad, Model.Capacidades, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Capacidad, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(m => m.Estado, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Estado, Model.Estados, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-primary">Cancelar</a>
            </div>
        }
    </div>
</div>
