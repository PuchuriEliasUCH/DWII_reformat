@model AltaMesa.web.Models.ViewModels.MesaListaVM

@{
    ViewBag.Title = "Mesas";
}

<div class="page-header">
    <h2>Mesas</h2>
    <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nueva Mesa</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:8%">ID</th>
                        <th style="width:20%">Número</th>
                        <th style="width:22%">Capacidad</th>
                        <th style="width:15%">Estado</th>
                        <th style="width:15%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Mesas.Any())
                    {
                        foreach (var m in Model.Mesas)
                        {
                            <tr>
                                <td>@m.IdMesa</td>
                                <td><span class="fw-medium">Mesa @m.Numero</span></td>
                                <td>@m.Capacidad personas</td>
                                <td>
                                    <span class="badge
                                        @(m.Estado == "Disponible" ? "badge-disponible" :
                                          m.Estado == "Ocupada" ? "badge-ocupada" :
                                          "badge-inhabilitada")">
                                        @m.Estado
                                    </span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Editar", new { id = m.IdMesa })" class="btn btn-sm btn-outline-primary">Editar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-on-surface-variant py-4">No hay mesas registradas</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
