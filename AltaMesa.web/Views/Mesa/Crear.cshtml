@model AltaMesa.web.Models.ViewModels.MesaCrearVM

@{
    ViewBag.Title = "Crear Mesa";
}

<div class="page-header">
    <h2>Crear Mesa</h2>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Crear", "Mesa", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Numero, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Numero, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.Numero, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Capacidad, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Capacidad, Model.Capacidades, "Seleccione capacidad", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Capacidad, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-primary">Cancelar</a>
            </div>
        }
    </div>
</div>
