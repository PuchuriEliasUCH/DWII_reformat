@model List<AltaMesa.web.DTOs.CategoriaDTO>

@{
    ViewBag.Title = "Categorías";
}

<div class="page-header">
    <h2>Categorías</h2>
    <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nueva Categoría</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:5%">ID</th>
                        <th style="width:18%">Nombre</th>
                        <th style="width:32%">Descripción</th>
                        <th style="width:10%">Estado</th>
                        <th style="width:35%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.IdCategoria</td>
                                <td class="fw-medium">@c.Nombre</td>
                                <td>@c.Descripcion</td>
                                <td>
                                    @if (c.Estado)
                                    {
                                        <span class="badge badge-activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 align-items-center">
                                        <a href="@Url.Action("Editar", new { id = c.IdCategoria })" class="btn btn-sm btn-outline-primary">Editar</a>
                                        @if (c.Estado)
                                        {
                                            using (Html.BeginForm("Desactivar", "Categoria", new { id = c.IdCategoria }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Desactivar esta categoría?')">Desactivar</button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-on-surface-variant py-4">No hay categorías registradas</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
