@model AltaMesa.web.Models.ViewModels.DashboardVM

@{
    ViewBag.Title = "Dashboard";
}

<h2 class="headline-md mb-4">Dashboard</h2>

<div class="row g-3 mb-4" id="dashboardCounters">
    <div class="col-md-2 col-6">
        <div class="counter-card">
            <div class="counter-value" style="color: var(--primary);" id="counterOcupadas">@Model.MesasOcupadas</div>
            <p class="counter-label">Mesas Ocupadas</p>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="counter-card">
            <div class="counter-value" style="color: var(--secondary);" id="counterDisponibles">@Model.MesasDisponibles</div>
            <p class="counter-label">Mesas Disponibles</p>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="counter-card">
            <div class="counter-value" style="color: var(--tertiary);" id="counterPedidos">@Model.PedidosActivos</div>
            <p class="counter-label">Pedidos Activos</p>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="counter-card">
            <div class="counter-value" style="color: var(--primary-container);" id="counterPreparacion">@Model.PlatosEnPreparacion</div>
            <p class="counter-label">Platos en Preparación</p>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="counter-card">
            <div class="counter-value" style="color: var(--secondary);" id="counterListos">@Model.PlatosListos</div>
            <p class="counter-label">Listos para Servir</p>
        </div>
    </div>
</div>

<div class="card" id="ultimosPedidosCard">
    <div class="card-header">
        <h5 class="headline-sm mb-0">Últimos Pedidos</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:8%">ID</th>
                        <th style="width:12%">Mesa</th>
                        <th style="width:22%">Mesero</th>
                        <th style="width:12%">Total</th>
                        <th style="width:18%">Estado</th>
                        <th style="width:18%">Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UltimosPedidos.Any())
                    {
                        foreach (var p in Model.UltimosPedidos)
                        {
                            <tr>
                                <td>@p.IdPedido</td>
                                <td>Mesa @p.NumeroMesa</td>
                                <td>@p.NombreMesero</td>
                                <td>$@p.Total.ToString("N2")</td>
                                <td>
                                    <span class="badge
                                        @(p.Estado == "Abierto" ? "badge-abierto" :
                                          p.Estado == "Enviado a cocina" ? "badge-enviado-a-cocina" :
                                          p.Estado == "En preparacion" ? "badge-en-preparacion" :
                                          p.Estado == "Parcialmente servido" ? "badge-parcialmente-servido" :
                                          p.Estado == "Cerrado" ? "badge-cerrado" :
                                          p.Estado == "Anulado" ? "badge-anulado" : "badge-abierto")">
                                        @p.Estado
                                    </span>
                                </td>
                                <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-on-surface-variant py-4">No hay pedidos activos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function actualizarCounters() {
            $.getJSON('@Url.Action("GetCounters", "Dashboard")', function (data) {
                $('#counterOcupadas').text(data.mesasOcupadas);
                $('#counterDisponibles').text(data.mesasDisponibles);
                $('#counterPedidos').text(data.pedidosActivos);
                $('#counterPreparacion').text(data.platosEnPreparacion);
                $('#counterListos').text(data.platosListos);
            });
        }

        $(function () {
            var pedidoHub = $.connection.pedidoHub;
            pedidoHub.client.nuevoPedido = function () { location.reload(); };
            pedidoHub.client.pedidoCerrado = function () { location.reload(); };
            pedidoHub.client.actualizarPedido = function () { actualizarCounters(); };
            pedidoHub.client.nuevoDetalleCocina = function () { actualizarCounters(); };
            pedidoHub.client.productoListo = function () { actualizarCounters(); };

            var cocinaHub = $.connection.cocinaHub;
            cocinaHub.client.nuevoDetalleCocina = function () { actualizarCounters(); };
            cocinaHub.client.actualizarDetalleCocina = function () { actualizarCounters(); };

            $.connection.hub.start().done(function () {
                pedidoHub.server.joinGroup();
                cocinaHub.server.joinGroup();
            });
        });
    </script>
}
