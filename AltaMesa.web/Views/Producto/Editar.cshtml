@model AltaMesa.web.Models.ViewModels.ProductoEditarVM

@{
    ViewBag.Title = "Editar Producto";
}

<div class="page-header">
    <h2>Editar Producto</h2>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Editar", "Producto", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdProducto)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Categoria, Model.Categorias, "Seleccione categoría", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Corta, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Corta, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Corta, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(m => m.Precio, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01" })
                    @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Larga, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Larga, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Larga, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3 form-check">
                @Html.CheckBoxFor(m => m.Prep, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.Prep, new { @class = "form-check-label" })
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-primary">Cancelar</a>
            </div>
        }
    </div>
</div>
