@model AltaMesa.web.Models.ViewModels.ProductoListaVM

@{
    ViewBag.Title = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Productos</h2>
    <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nuevo Producto</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Preparación</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Productos.Any())
                {
                    foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td>@p.IdProducto</td>
                            <td>@p.Nombre</td>
                            <td>@p.Categoria</td>
                            <td>$@p.Precio.ToString("N2")</td>
                            <td>
                                @if (p.RequierePreparacion)
                                {
                                    <span class="badge bg-warning text-dark">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">No</span>
                                }
                            </td>
                            <td>
                                @if (p.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay productos registrados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
