@model AltaMesa.web.Models.ViewModels.ProductoListaVM

@{
    ViewBag.Title = "Productos";
}

<div class="page-header">
    <h2>Productos</h2>
    <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nuevo Producto</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:8%">ID</th>
                        <th style="width:22%">Nombre</th>
                        <th style="width:17%">Categoría</th>
                        <th style="width:10%">Precio</th>
                        <th style="width:8%">Prep.</th>
                        <th style="width:10%">Estado</th>
                        <th style="width:15%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Productos.Any())
                    {
                        foreach (var p in Model.Productos)
                        {
                            <tr>
                                <td>@p.IdProducto</td>
                                <td class="fw-medium">@p.Nombre</td>
                                <td>@p.Categoria</td>
                                <td>$@p.Precio.ToString("N2")</td>
                                <td>
                                    @if (p.RequierePreparacion)
                                    {
                                        <span class="badge badge-si">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-no">No</span>
                                    }
                                </td>
                                <td>
                                    @if (p.Estado)
                                    {
                                        <span class="badge badge-activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 align-items-center">
                                        <a href="@Url.Action("Editar", new { id = p.IdProducto })" class="btn btn-sm btn-outline-primary">Editar</a>
                                        @using (Html.BeginForm("Eliminar", "Producto", new { id = p.IdProducto }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Desactivar este producto?')">Desactivar</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-on-surface-variant py-4">No hay productos registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
